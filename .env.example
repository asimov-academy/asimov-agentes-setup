# Gerado pelo setup. Nunca commite o .env. Permissão 600.

# empresa: agentes só da própria empresa. revenda: agentes para empresas clientes.
MODO_INSTALACAO=

DOMINIO_BASE=
SUBDOMINIO_BOT=
EMAIL_SSL=
AGENTE_CODIGO=
# oracle: o firewall abre 80 e 443 antes do REJECT que a imagem da Oracle Cloud traz. outro: nada muda.
PROVEDOR_VPS=

# Versão das imagens da plataforma (ghcr.io/asimov-academy/agentes-*). Gravada pelo setup e por
# `asimov atualizar`; o Compose não sobe sem ela.
ASIMOV_VERSAO=
# De onde as imagens vêm e com que usuário o `docker login` é feito. Vazios, valem os padrões do
# setup. O token NUNCA fica aqui: ele mora só na credencial do Docker.
ASIMOV_REGISTRO=
ASIMOV_REGISTRO_USUARIO=

POSTGRES_USER=asimov
POSTGRES_PASSWORD=
POSTGRES_DB=asimov

CHAVE_API_ADMIN=
CHAVE_CRIPTOGRAFIA=

# Conta de IA do operador, vinculada por `asimov ia`. O segredo do login fica onde o CLI oficial
# guarda (CREDENCIAL_IA_HOST, modo 600 dele), nunca aqui: o .env só diz que existe vínculo, com
# qual CLI e em que conta, que é o que o painel precisa para mostrar ou esconder o copiloto.
IA_VINCULADA=
IA_CLI=
IA_CONTA=
CREDENCIAL_IA_HOST=
CREDENCIAL_IA_CONTAINER=
# Contêiner do copiloto. Sobe quando há conta vinculada e painel ligado, e é o único que leva o
# CLI dentro. O `dc` lê esta linha para passar o perfil ao Compose.
COPILOTO_ATIVO=

# Painel do operador no navegador. Vazio é o normal: administração pelo terminal, como sempre.
# `asimov painel` liga, escreve o bloco do Caddy em deploy/caddy/ e reinicia a API.
PAINEL_ATIVO=
SUBDOMINIO_APP=

# WhatsApp pela WAHA. A chave e a versão nascem na instalação, junto com o contêiner: ligar o
# WhatsApp depois, pelo terminal ou pelo painel, não precisa subir serviço nenhum.
WAHA_API_KEY=
VERSAO_WAHA=
# Nome que o celular mostra em Aparelhos conectados; o setup grava o do agente antes de parear.
WAHA_CLIENT_DEVICE_NAME=
WAHA_CLIENT_BROWSER_NAME=

# Só instalação feita até a v0.19: modelos padrão e chaves escolhidos no setup, que seguem valendo.
# Na instalação nova ficam vazios: o modelo é de cada agente e a chave fica cifrada no banco.
MODELO_CONVERSA=
MODELO_FALLBACK=
MODELO_VISAO=
MODELO_TRANSCRICAO=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Raciocínio dos modelos da OpenAI que vêm com ele desligado (gpt-5.1): vazio vale low; none desliga.
OPENAI_RACIOCINIO=

# Idioma dos áudios recebidos (código de duas letras). Vazio deixa o transcritor adivinhar.
IDIOMA_AUDIO=pt

LOG_NIVEL=INFO
