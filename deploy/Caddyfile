{
	email {$EMAIL_SSL}
	# De quem o Caddy aceita o X-Forwarded-For. O setup grava private_ranges só quando o proxy do
	# host fica na frente (portas em 127.0.0.1); no modo próprio vale só o loopback.
	servers {
		trusted_proxies static {$ASIMOV_PROXIES_CONFIAVEIS:127.0.0.1/32}
	}
}

{$ASIMOV_ESQUEMA:https}://{$SUBDOMINIO_BOT} {
	# Só webhooks, health e o que a Meta exige para publicar o app (a URL da política de
	# privacidade e o ícone) ficam públicos, mais o link de envio de arquivos (uso único, 30 min).
	# /admin responde apenas em 127.0.0.1:8000.
	@publico path /health /webhook/* /privacidade* /icone-app.png
	handle @publico {
		reverse_proxy api:8000
	}
	# O link de envio é a única rota pública que recebe arquivo: o teto fica aqui também, antes de
	# o corpo chegar à API.
	handle /envio/* {
		request_body {
			max_size 51MiB
		}
		reverse_proxy api:8000
	}
	handle {
		respond 404
	}
}

# Painel do operador, quando ele escolhe administrar pelo navegador. O arquivo existe sempre (um
# glob que não casa nada é erro no Caddy) e só tem um comentário enquanto o painel está desligado.
# Quem escreve é setup/lib/painel.sh, e depois recarrega o Caddy (caddy_carrega): mudar um arquivo
# montado não muda o que o Caddy já carregou.
import /etc/caddy/extras/*.caddy
